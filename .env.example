# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. The anon key is safe to expose in the browser;
# your data is protected by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Luma (optional) — powers the events sidebar. Leave blank to disable.
# Get an API key from https://lu.ma if you want live event data.
LUMA_API_URL=https://public-api.lu.ma/public/v1
LUMA_API_KEY=your-luma-api-key
